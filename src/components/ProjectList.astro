---
import projects from '../data/projects.json';
---
<div class="project-list">{projects.map((project) => <article class="project">
  <div class="project-meta"><span>{project.category}</span><span>{project.period}</span></div>
  <div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div>
  {project.links.length > 0 && <div class="links">{project.links.map((item: {label: string; url: string}) => <a href={item.url}>{item.label}</a>)}</div>}</div>
</article>)}</div>
