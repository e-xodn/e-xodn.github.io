---
import type { CollectionEntry } from 'astro:content';
import { link, formatDate } from '../lib/links';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
{posts.length ? <div class="post-list">{posts.map(post => <article class="post-row">
  <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.category}</span></div>
  <div><h3><a href={link(`blog/${post.id}/`)}>{post.data.title}</a> {post.data.draft && <small class="draft">Draft · local preview</small>}</h3><p>{post.data.description}</p></div>
</article>)}</div> : <p class="empty">No posts published yet. Notes on AI, research, and learning will appear here.</p>}
