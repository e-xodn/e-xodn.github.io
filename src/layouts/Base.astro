---
import '../styles/global.css';
import profile from '../data/profile.json';
import { siteConfig } from '../../site.config.mjs';
import { link } from '../lib/links';
interface Props { title: string; description?: string; lang?: string; }
const { title, description = profile.introduction, lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['About', ''], ['Projects', 'projects/'], ['Writing', 'blog/']];
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · {profile.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={link()}>{profile.name}<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">{nav.map(([label, target]) => <a href={link(target)} aria-current={path === link(target) ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main class="wrap" id="main"><slot /></main>
    <footer class="wrap"><span>© {new Date().getFullYear()} {profile.name}</span><a href={`https://github.com/${siteConfig.githubUsername}`}>GitHub</a></footer>
  </body>
</html>
