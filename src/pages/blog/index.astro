---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing"><p class="eyebrow">AI trends · AX · Insights · Study notes</p><h1>Writing</h1><p class="lead">What I am reading, building, and thinking about.</p><PostList posts={posts} /></Base>
